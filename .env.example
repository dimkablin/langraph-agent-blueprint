# LangGraph Agent Blueprint environment example.
# Copy this file to .env in the project root. Process environment variables
# override values from .env.

# Provider selection: fake, openai, openai_compatible, ollama, anthropic.
LLM_PROVIDER=fake

# Generic fallback model name. Provider-specific model variables below override
# this for their provider when set.
MODEL_NAME=fake-model

# Anthropic provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible provider, including Ollama /v1, LiteLLM, vLLM, etc.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Permission policy: default, accept_edits, bypass_read_only, plan, strict.
PERMISSION_MODE=default

# Enables network-backed tools and git plugin install/update when true/1/yes.
NETWORK_ENABLED=false

# Runtime storage directory. CC_LANGGRAPH_STORAGE_DIR is the preferred name.
CC_LANGGRAPH_STORAGE_DIR=.storage

# Legacy storage alias still read by AppConfig.from_env().
langgraph_agent_blueprint_STORAGE_DIR=

# Additional file-based skill roots. Use OS path separator or comma.
# Windows example: C:\skills;D:\team-skills
# POSIX example: /opt/skills:/home/me/skills
SKILLS_PATHS=

# Alias for SKILLS_PATHS. Used only when SKILLS_PATHS is empty/unset.
LG_AGENT_SKILLS_PATHS=

# Additional plugin roots. Use OS path separator or comma.
# Installed plugins are also loaded from <storage>/plugins.
PLUGIN_PATHS=

# Alias for PLUGIN_PATHS. Used only when PLUGIN_PATHS is empty/unset.
LG_AGENT_PLUGIN_PATHS=

# FastAPI CORS allowlist.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Frontend API base URL for Vite.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Langfuse observability. Leave disabled unless a Langfuse project
# and keys are configured. Never commit real keys.
# Process environment variables override this file. Within this file,
# LANGFUSE_ENVIRONMENT is preferred over LANGFUSE_TRACING_ENVIRONMENT.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_HOST=
LANGFUSE_ENVIRONMENT=dev
LANGFUSE_TRACING_ENVIRONMENT=
LANGFUSE_RELEASE=
LANGFUSE_TRACE_USER_ID=
LANGFUSE_DEBUG=false
LANGFUSE_CAPTURE_INPUTS=true
LANGFUSE_CAPTURE_OUTPUTS=true
LANGFUSE_INCLUDE_PROJECT_PATHS=false
# high_signal records only important runtime events as child observations and
# keeps low-signal lifecycle noise as compact trace metadata.
# Options: high_signal, all, metadata_only, off.
LANGFUSE_RUNTIME_EVENTS_MODE=high_signal
